{
  "expo": {
    "name": "MORA",
    "slug": "mora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morabeza.mora"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "package": "com.morabeza.mora"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "MORA - morabeza, every connection. Warmer than Snapchat, realer than ghost.",
    "primaryColor": "#FF6B35"
  }
}
